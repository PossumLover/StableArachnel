    </g>
  </defs>
  <path d="m80 92 79-14v4l-79 14z" fill="$pine"/>
  <use xlink:href="#seedling" transform="translate(92 90)"/>
  <use xlink:href="#seedling" transform="translate(119 85) scale(.9)"/>
  <use xlink:href="#seedling" transform="translate(145 80) scale(.8)"/>

