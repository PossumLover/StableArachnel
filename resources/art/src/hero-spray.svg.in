<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="450" height="420" viewBox="450 0 450 420">
  <defs>
    <g id="poppy">
      <!-- Thin rear petals, then two overlapping cups with cut lines following the folds. -->
      <path d="M-4 8C-19 6-53-9-52-33Q-55-49-43-45Q-36-57-26-48Q-11-57-5-39L3-13Z" fill="$fold"/>
      <path d="M-3 2C-30-24-26-50-21-60Q-19-67-10-61Q-1-72 8-62Q20-69 24-55Q35-57 32-44Q25-15 5 3Z" fill="$petal"/>
      <path d="M2 5C2-14 15-47 33-53Q42-61 47-51Q60-53 59-40Q72-40 61-22Q48-2 12 9Z" fill="$silk"/>
      <path d="M-7 9C-25 6-52-5-61-27Q-68-43-55-41Q-50-50-39-39Q-20-40-13-23Q-5-15 1-3Z" fill="$silk"/>
      <g stroke="$fold" fill="none" stroke-width="1.6" stroke-linecap="round" opacity=".78">
        <path d="M-9-2Q-22-20-39-31M-13-2Q-33-11-47-28M14-4Q29-15 37-36M21-4Q42-14 46-29M4-15Q10-35 8-49"/>
      </g>
      <!-- Short stamens curve around the seed head. The near petal hides their bases. -->
      <g fill="none" stroke="$gold" stroke-width="2.4" stroke-linecap="round">
        <path d="M-4 1q-6-3-8-10m12 9q-5-7-5-14m9 13q1-7 5-12m-3 15q5-4 8-8"/>
      </g>
      <g transform="translate(1 -5) rotate(-12)">
        <path d="M-5-1Q-6 6 0 8Q6 6 5-1Z" fill="$meadow"/>
        <ellipse cy="-1" rx="6.2" ry="3.8" fill="$etch"/>
        <path d="m-4-2 4 1 3-2m-3 2 1 2" fill="none" stroke="$leaf" stroke-width="1.2" stroke-linecap="round"/>
      </g>
      <path d="M-26-8Q-16-12-6-4Q3 3 13 0Q23-3 31-11Q27 4 12 11Q-5 18-18 5Z" fill="$petal"/>
      <path d="M-17-4Q-3 9 12 4Q5 11-4 10Z" fill="$fold" opacity=".65"/>
    </g>
    <g id="blade">
      <path d="M0 0Q-3-13 8-25L9-17Q18-39 33-47L30-36Q44-51 59-56Q52-36 41-26L47-27Q28-7 0 0Z" fill="$leaf"/>
      <path d="M3-3Q23-19 49-46" stroke="$etch" fill="none" stroke-width="1.5"/>
    </g>
    <g id="pod">
      <path d="M0 2C-10 1-18-14-14-24Q-9-34 0-31Q13-33 16-21Q18-9 3 2Z" fill="$meadow"/>
      <path d="M-4-1Q-10-14-7-23M3-2Q11-15 8-24" stroke="$etch" stroke-width="1.7" fill="none"/>
      <path d="m-11-28 3-5 6 2 4-4 4 3 7 1-3 5z" fill="$pine"/>
    </g>
    <g id="disc">$sky_disc</g>
  </defs>
  <use xlink:href="#disc" transform="translate(646 161) scale(2.5)" opacity=".51"/>
  <!-- Stalks fan out from the lower edge of the card. -->
  <g fill="none" stroke-linecap="round">
    <path d="M771 432Q731 330 757 204Q774 102 749 78M747.66 272Q710 221 705 193" stroke="$leaf" stroke-width="3.8"/>
    <path d="M667 427C685 336 653 227 619 193M870 433Q825 358 849 271Q857 233 836 215" stroke="$pine" stroke-width="4.2"/>
    <path d="M714 429Q689 365 638 330Q598 298 571 263M835 426Q817 356 796 309" stroke="$leaf" stroke-width="3"/>
  </g>
  <use xlink:href="#blade" transform="translate(667.65 315) rotate(-100) scale(1.04)"/>
  <use xlink:href="#blade" transform="translate(665.55 303) rotate(-20) scale(.82)"/>
  <use xlink:href="#blade" transform="translate(747 312) rotate(18) scale(1.35)"/>
  <use xlink:href="#blade" transform="translate(751 235) scale(-.87 .87)"/>
  <use xlink:href="#blade" transform="translate(841 338) rotate(14)"/>
  <use xlink:href="#blade" transform="translate(650.09 339) scale(-.87 .87) rotate(21)"/>
  <use xlink:href="#pod" transform="translate(705 193) rotate(-26) scale(.78)"/>
  <use xlink:href="#pod" transform="translate(796 309) rotate(-25)"/>
  <use xlink:href="#pod" transform="translate(571 263) rotate(-36) scale(.8)"/>
  <use xlink:href="#poppy" transform="translate(619 194) rotate(-21) scale(.89)"/>
  <use xlink:href="#poppy" transform="translate(749 81) rotate(12)"/>
  <use xlink:href="#poppy" transform="translate(836 218) rotate(22) scale(-.67 .67)"/>
  <!-- A fritillary in profile. The pale windows echo the glasshouse panes. -->
  <g transform="translate(514 125) rotate(-13)">
    <path d="M5 0Q-11-7-27-30Q-32-44-19-40Q-1-35 8-9Q9-29 21-30Q30-29 23-14Q20-6 10 0Z" fill="$wing"/>
    <path d="M4-2Q-18-15-24-11Q-31-4-19 2Q-8 7 6 1Z" fill="$petal"/>
    <path d="M-23-35Q-12-32-2-14Q-14-22-23-35Zm7 15q7 3 12 10-10-3-12-10Zm31 6q1-8 6-11-1 7-6 11Z" fill="$pollen"/>
    <path d="m2 3 12-8m-1 0q4-6 6-6" fill="none" stroke="$pine" stroke-width="2.4" stroke-linecap="round"/>
  </g>
</svg>
