    <g id="cut" fill="none" stroke="$etch" stroke-width="1.3" stroke-linecap="round">
      <path d="m-8 0 4-3m1 3 5-4m1 3 3-2"/>
    </g>
  </defs>
  <!-- Each ridge crosses the next at a different angle. Sky is transparent. -->
