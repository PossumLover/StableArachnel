  <path d="M436 124Q471 128 446 134Q414 140 364 146Q294 155 310 180H352Q329 161 382 151Q425 144 456 137Q490 127 442 123Z" fill="$field"/>
  <g fill="none" stroke="$etch" stroke-width="1.5" opacity=".6" stroke-linecap="round">
